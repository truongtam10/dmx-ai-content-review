  "content": {
    "shortDescription_content": {
      "label": "Thông tin nhanh",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi OLED LG 65C6PSA với độ phân giải 4K, tần số quét 120Hz, hỗ trợ Dolby Vision, HDR10, HLG, AI Picture Pro, AI Sound Pro, điều khiển bằng giọng nói, chiếu màn hình từ điện thoại, AI Magic Remote MR26."
    },
    "hotReason_content": {
      "label": "Key selling points",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Bộ xử lý α11 AI Processor 4K Gen3, AI Picture Pro, Dolby Vision, HDR10, HLG, 120Hz Native, Gsync, Freesync, ALLM, LG ThinQ, Google Cast, Hey Google, Airplay 2, AI Magic Remote MR26, α11 AI Sound Pro, Clear Voice Pro, WOW Orchestra"
    },
    "description_content": {
      "label": "Tính năng nổi bật",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi OLED LG 65C6PSA là sản phẩm cao cấp với độ phân giải 4K Ultra HD, sử dụng tấm nền OLED cho màu đen hoàn hảo và độ tương phản cao. Được trang bị bộ xử lý α11 AI Processor 4K Gen3, tivi mang lại trải nghiệm hình ảnh vượt trội với các công nghệ như AI Picture Pro, AI Brightness Control, AI HDR Remastering và Dolby Vision. Tần số quét 120Hz Native cùng hỗ trợ VRR 165Hz, Gsync, Freesync và ALLM giúp chơi game mượt mà. Hệ điều hành Web OS 26 cung cấp giao diện thân thiện, tích hợp LG ThinQ, Google Cast, Hey Google và Airplay 2 cho điều khiển thông minh và chia sẻ nội dung dễ dàng. Remote AI Magic Remote MR26 hỗ trợ cử chỉ và giọng nói. Âm thanh 40W với công nghệ α11 AI Sound Pro, Clear Voice Pro và WOW Orchestra mang lại trải nghiệm âm thanh sống động. Tivi hỗ trợ HDMI eARC, Wifi 6, Bluetooth 5.3 và nhiều cổng kết nối hiện đại."
    }
  },
