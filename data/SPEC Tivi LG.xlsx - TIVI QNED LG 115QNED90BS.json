  "content": {
    "shortDescription_content": {
      "label": "Thông tin nhanh",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi LG 115QNED90BS với màn hình 115 inch, độ phân giải 4K Ultra HD, công nghệ QNED MiniLED và hệ điều hành Web OS 26, mang lại trải nghiệm hình ảnh và âm thanh đỉnh cao."
    },
    "hotReason_content": {
      "label": "Key selling points",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Màn hình 115 inch 4K QNED MiniLED, Bộ xử lý α8 AI Processor 4K Gen3, Tần số quét 120Hz Native, Công nghệ AI Picture Pro, AI Sound Pro, hỗ trợ Dolby Vision, HDR10, LG ThinQ, Google Cast, Airplay 2, tích hợp MS Copilot."
    },
    "description_content": {
      "label": "Tính năng nổi bật",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi LG 115QNED90BS sở hữu công nghệ hình ảnh tiên tiến với α8 AI Processor 4K Gen3, nâng cấp hình ảnh tự động, độ sáng thông minh, HDR Remastering và Dynamic Tone Mapping Pro. Âm thanh 40W với α8 AI Sound Pro, hỗ trợ Dolby Atmos, Clear Voice Pro và WOW Orchestra. Kết nối đa dạng với 4 cổng HDMI (eARC), USB, Wi-Fi 5, Bluetooth 5.3, hỗ trợ chiếu màn hình từ điện thoại qua Airplay 2 và Google Cast. Remote thông minh AI Magic Remote MR26 và điều khiển bằng giọng nói qua Google Assistant."
    }
  },
