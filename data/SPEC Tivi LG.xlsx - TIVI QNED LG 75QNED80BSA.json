  "content": {
    "shortDescription_content": {
      "label": "Thông tin nhanh",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi 4K QNED MiniLED LG 75QNED80BSA với màn hình 75 inch, độ phân giải 4K Ultra HD, trang bị Bộ xử lý α7 AI Processor 4K Gen9, hệ điều hành Web OS 26, công nghệ hình ảnh Dynamic QNED Color Pro, AI Brightness control, HDR10/HLG và nhiều tiện ích thông minh như LG ThinQ, Google Cast, Airplay 2, AI Magic Remote MR26."
    },
    "hotReason_content": {
      "label": "Key selling points",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Bộ xử lý α7 AI Processor 4K Gen9, Công nghệ hình ảnh Dynamic QNED Color Pro, AI Brightness control, HDR10/HLG, Tần số quét 60Hz Native, Tiện ích LG ThinQ, Google Cast, Airplay 2, AI Magic Remote MR26, Tích hợp MS Copilot, Trình duyệt web toàn màn hình."
    },
    "description_content": {
      "label": "Tính năng nổi bật",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi LG 75QNED80BSA sở hữu màn hình 75 inch độ phân giải 4K Ultra HD với công nghệ QNED MiniLED cho hình ảnh sống động, màu sắc chân thực. Được trang bị Bộ xử lý α7 AI Processor 4K Gen9 hỗ trợ AI Upscaling, AI HDR Remastering và AI Emotional Remastering. Hệ điều hành Web OS 26 mang lại trải nghiệm thông minh với LG ThinQ, Google Cast, Hey Google và điều khiển bằng giọng nói. Hỗ trợ chiếu màn hình từ điện thoại qua Airplay 2 và Google Cast. Remote thông minh AI Magic Remote MR26 và tích hợp MS Copilot giúp nâng cao trải nghiệm người dùng. Âm thanh 20W với công nghệ AI Sound Pro, Clear Voice Pro và WOW Orchestra. Kết nối đa dạng với 3 cổng HDMI (eARC), USB A, Optical, Bluetooth 5.3 và Wi-Fi 5."
    }
  },
