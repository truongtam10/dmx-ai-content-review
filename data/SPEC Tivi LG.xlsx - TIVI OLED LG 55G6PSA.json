    "shortDescription_content": {
      "label": "Thông tin nhanh",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi OLED LG 55G6PSA với độ phân giải 4K, tấm nền OLED cho màu đen hoàn hảo, hệ điều hành Web OS 26, tần số quét 120Hz, hỗ trợ Dolby Vision, HDR10, HLG và nhiều công nghệ hình ảnh AI tiên tiến."
    },
    "hotReason_content": {
      "label": "Key selling points",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Bộ xử lý α11 AI Processor 4K Gen3, OLED Perfect Black, Web OS 26, 120Hz Native, Dolby Vision, AI Picture Pro, LG ThinQ, Google Cast, Airplay 2, AI Magic Remote MR26, Tích hợp MS Copilot"
    },
    "description_content": {
      "label": "Tính năng nổi bật",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi OLED LG 55G6PSA mang đến trải nghiệm hình ảnh đỉnh cao với công nghệ α11 AI Processor 4K Gen3, nâng cấp chất lượng hình ảnh, màu sắc chính xác và độ sáng tự động điều chỉnh. Hỗ trợ nhiều chế độ hình ảnh, gaming với độ trễ dưới 0.1ms, tích hợp trợ lý ảo Google và LG ThinQ, điều khiển bằng giọng nói, chiếu màn hình từ điện thoại, và tích hợp MS Copilot. Âm thanh 60W với công nghệ α11 AI Sound Pro và Clear Voice Pro, kết nối đa dạng với HDMI eARC, USB, Wifi 6, Bluetooth 5.3."
    }
  },
