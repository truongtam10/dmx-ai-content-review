  "content": {
    "shortDescription_content": {
      "label": "Thông tin nhanh",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi QNED LG 65QNED86BSA - 65 inch, 4K Ultra HD, MiniLED, Web OS 26, 120Hz Native, hỗ trợ AI, Google Cast, Airplay 2, AI Magic Remote."
    },
    "hotReason_content": {
      "label": "Key selling points",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Công nghệ QNED MiniLED, AI xử lý hình ảnh & âm thanh, điều khiển bằng giọng nói tiếng Việt, chiếu màn hình từ điện thoại, Freesync cho gaming, tích hợp MS Copilot."
    },
    "description_content": {
      "label": "Tính năng nổi bật",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi LG 65QNED86BSA sở hữu tấm nền MiniLED với độ phân giải 4K, tần số quét 120Hz Native, hỗ trợ VRR 144Hz và Freesync cho trải nghiệm gaming mượt mà. Hệ điều hành Web OS 26 tích hợp Google Assistant, LG ThinQ và Airplay 2. Remote thông minh AI Magic Remote MR26 và tính năng Multiview giúp điều khiển dễ dàng và xem nhiều nội dung cùng lúc. Âm thanh 20W với công nghệ α8 AI Sound Pro và Clear Voice Pro mang lại trải nghiệm sống động."
    }
  },
