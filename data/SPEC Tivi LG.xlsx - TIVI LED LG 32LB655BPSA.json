  "content": {
    "shortDescription_content": {
      "label": "Thông tin nhanh",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi LED 32 inch, độ phân giải HD, Web OS 26, α5 AI Processor Gen9, hỗ trợ LG ThinQ, Google Cast, Airplay 2, AI Magic Remote MR26."
    },
    "hotReason_content": {
      "label": "Key selling points",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Web OS 26, α5 AI Processor Gen9, HDR10/HLG, AI Brightness control, LG ThinQ, Google Cast, Airplay 2, AI Magic Remote MR26"
    },
    "description_content": {
      "label": "Tính năng nổi bật",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi LED LG 32LB655BPSA sở hữu màn hình 32 inch độ phân giải HD, trang bị bộ xử lý α5 AI Processor Gen9 giúp nâng cao chất lượng hình ảnh với các công nghệ như Resolution Upscaler, AI Brightness control, HDR10/HLG. Hệ điều hành Web OS 26 mang lại trải nghiệm thông minh với LG ThinQ, Google Cast, Hey Google và hỗ trợ Airplay 2. Remote thông minh AI Magic Remote MR26 cùng các tiện ích AI như AI Agent, AI Concierge, tích hợp MS Copilot và trình duyệt web toàn màn hình. Âm thanh 2.0 ch với công suất 10W, hỗ trợ AI Sound Pro và Clear Voice Pro. Kết nối đa dạng với 2 cổng HDMI (eARC), 1 USB 2.0, Wi-Fi 5 và Bluetooth 5.3."
    }
  },
