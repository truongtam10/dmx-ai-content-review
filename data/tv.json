    "content": {
        "shortDescription_content": {
            "label": "Thông tin nhanh",
            "cmsCode": null,
            "propertyType": "textarea",
            "value": "Tivi OLED 97 inch, độ phân giải 4K, hệ điều hành Web OS 26, chip α11 AI Processor 4K Gen3, tần số quét 120Hz Native, hỗ trợ Dolby Vision, HDR10, HLG, điều khiển bằng giọng nói Google Cast, Hey Google, LG ThinQ, remote AI Magic Remote MR26, HDMI eARC, Wifi 6, công nghệ âm thanh α11 AI Sound Pro, tổng công suất loa 60W"
        },
        "hotReason_content": {
            "label": "Key selling points",
            "cmsCode": null,
            "propertyType": "textarea",
            "value": "Tivi OLED 97 inch với công nghệ AI hình ảnh và âm thanh đỉnh cao, trải nghiệm giải trí siêu thực, điều khiển thông minh bằng giọng nói và remote AI, kết nối đa thiết bị, thiết kế sang trọng phù hợp không gian cao cấp."
        },
        "description_content": {
            "label": "Tính năng nổi bật",
            "cmsCode": null,
            "propertyType": "textarea",
            "value": "Công nghệ hình ảnh: α11 AI Super Upscaling 4K, AI Picture Pro, Dolby Vision, HDR10, HLG, OLED Dynamic Tone Mapping Ultra. Công nghệ âm thanh: α11 AI Sound Pro (Virtual 11.1.2 Up-mix), Clear Voice Pro, AI Acoustic Tuning, LG Sound Sync. Kết nối: HDMI eARC, Wifi 6, Bluetooth 5.3, 3 cổng USB A. Tiện ích: LG ThinQ, Google Cast, Hey Google, Airplay 2, AI Magic Remote MR26, trình duyệt web toàn màn hình, Multiview."
        }
    },
