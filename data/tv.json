            "propertyType": "yes/no",
            "value": null,
            "isPim": true
        },
        "short_product_articles": {
            "label": "Mô tả ngắn sản phẩm",
            "cmsCode": null,
            "propertyType": "text area",
            "value": "Smart Tivi OLED LG 97 inch 97G6PSA với công nghệ hình ảnh AI tiên tiến, trải nghiệm giải trí đỉnh cao với độ phân giải 4K, âm thanh vòm 4.2 ch và kết nối thông minh.",
            "isPim": true
        },
        "is_service": false,
        "product_articles": {
            "value": "Smart Tivi OLED LG AI 4K 97 inch 97G6PSA là sản phẩm cao cấp thuộc dòng Tivi OLED evo, được sản xuất tại Hàn Quốc và ra mắt vào năm 2026. Với kích thước màn hình lên đến 97 inch, thiết bị mang đến trải nghiệm hình ảnh hoành tráng, lý tưởng cho không gian sống hiện đại và phòng giải trí cao cấp. Màn hình 4K Ultra HD kết hợp công nghệ OLED mang lại độ tương phản vô hạn, màu đen sâu và sắc màu chân thực, sống động.\n\nTivi được trang bị hệ điều hành Web OS 26, vận hành trên bộ xử lý Snapdragon 8+ Gen 1 8 nhân, đảm bảo hiệu năng mạnh mẽ, xử lý mượt mà các ứng dụng và nội dung đa phương tiện. Tần số quét 120 Hz cùng các công nghệ hình ảnh tiên phong như α11 AI Super Upscaling 4K, AI Picture Pro, AI HDR Remastering, AI Emotional Remastering và Dynamic Tone Mapping giúp tối ưu hóa chất lượng hình ảnh theo từng khung hình. Hỗ trợ các định dạng HDR bao gồm Dolby Vision, HDR10, HLG và các chế độ QMS (Quick Media Switching), QFT (Quick Frame Transport), G-Sync, tivi đáp ứng tốt cả nhu cầu xem phim và chơi game.\n\nÂm thanh được nâng tầm với α11 AI Sound Pro, tạo hiệu ứng âm thanh ảo 11.1.2, cùng AI Acoustic Tuning tự động điều chỉnh theo môi trường. Các tính năng như LG Sound Sync, TV Sound Mode Share và WOW Orchestra giúp đồng bộ và khuếch đại trải nghiệm âm thanh. Tivi hỗ trợ kết nối đa dạng: Wi-Fi 6, cổng LAN, Bluetooth 5.3, HDMI eARC và tương thích AirPlay 2, Google Cast, LG ThinQ. Remote thông minh RMF-TX920V tích hợp đèn nền và micro tìm kiếm bằng giọng nói, hỗ trợ điều khiển bằng lệnh Hey Google. Ngoài ra, tivi còn tích hợp MS Copilot và trình duyệt web toàn màn hình, mở rộng tiện ích sử dụng.",
            "label": "Bài viết sản phẩm",
            "propertyType": "text area",
            "isPim": true,
            "cmsCode": null
        },
        "is_request_imei": false,
        "is_base_product": true,
        "release_date": {
            "label": "Ngày ra mắt",
            "cmsCode": null,
