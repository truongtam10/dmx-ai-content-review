  "content": {
    "shortDescription_content": {
      "label": "Thông tin nhanh",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi OLED LG 77B6PSA với độ phân giải 4K, kích thước 77 inch, trang bị bộ xử lý α8 AI Processor 4K Gen3, hệ điều hành Web OS 26, hỗ trợ nhiều công nghệ hình ảnh và âm thanh cao cấp, kết nối đa dạng với LG ThinQ, Google Cast, Airplay 2."
    },
    "hotReason_content": {
      "label": "Key selling points",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Bộ xử lý α8 AI Processor 4K Gen3, AI Picture Pro, Dolby Vision / HDR10 / HLG, Tần số quét 120Hz Native, LG ThinQ, Google Cast, Hey Google, Airplay 2, AI Magic Remote MR26, α8 AI Sound Pro, Clear Voice Pro"
    },
    "description_content": {
      "label": "Tính năng nổi bật",
      "cmsCode": null,
      "propertyType": "textarea",
      "value": "Tivi OLED LG 77B6PSA mang đến trải nghiệm hình ảnh đỉnh cao với công nghệ OLED cho màu đen hoàn hảo, độ phân giải 4K Ultra HD và bộ xử lý α8 AI Processor 4K Gen3. Tivi hỗ trợ nhiều chế độ hình ảnh, công nghệ AI nâng cấp hình ảnh, âm thanh vòm ảo 11.1.2 với α8 AI Sound Pro, kết nối thông minh qua LG ThinQ, Google Cast, Airplay 2 và điều khiển bằng giọng nói với Hey Google. Remote thông minh AI Magic Remote MR26 giúp thao tác dễ dàng. Tivi phù hợp cho giải trí, xem phim, chơi game với độ trễ hình ảnh dưới 0.1ms."
    }
  },
