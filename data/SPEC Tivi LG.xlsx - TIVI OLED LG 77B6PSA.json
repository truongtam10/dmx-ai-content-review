    "key_selling_points": {
      "label": "Đặc điểm sản phẩm",
      "cmsCode": null,
      "propertyType": "text area",
      "value": "Bộ xử lý α8 AI Processor 4K Gen3, AI Picture Pro, Dolby Vision / HDR10 / HLG, Tần số quét 120Hz Native, LG ThinQ, Google Cast, Hey Google, Airplay 2, AI Magic Remote MR26, α8 AI Sound Pro, Clear Voice Pro",
      "isPim": true
    },
    "short_product_articles": {
      "label": "Mô tả ngắn sản phẩm",
      "cmsCode": null,
      "propertyType": "text area",
      "value": "Tivi OLED LG 77B6PSA với độ phân giải 4K, kích thước 77 inch, trang bị bộ xử lý α8 AI Processor 4K Gen3, hệ điều hành Web OS 26, hỗ trợ nhiều công nghệ hình ảnh và âm thanh cao cấp, kết nối đa dạng với LG ThinQ, Google Cast, Airplay 2.",
      "isPim": true
    },
    "product_articles": {
      "value": "Smart Tivi OLED LG 4K 77 inch 77B6PSA là sản phẩm cao cấp mang đến trải nghiệm hình ảnh và âm thanh đỉnh cao, phù hợp với không gian giải trí hiện đại. Với màn hình OLED 77 inch độ phân giải 4K Ultra HD, tivi tái tạo hình ảnh với độ tương phản hoàn hảo nhờ công nghệ Perfect Black, cho màu đen sâu tuyệt đối và từng chi tiết sáng rõ nét. Dải màu siêu rộng Perfect Color kết hợp cùng AI Picture Pro và bộ xử lý α8 AI Processor 4K Gen3 nâng cao chất lượng hình ảnh, hỗ trợ α8 AI Super Upscaling 4K để tối ưu nội dung từ độ phân giải thấp lên gần chuẩn 4K.\n\nTivi trang bị tần số quét 120Hz, hỗ trợ OLED Motion Pro và OLED Dynamic Tone Mapping Pro, đảm bảo chuyển động mượt mà, đặc biệt trong các cảnh hành động nhanh hoặc chơi game. Độ trễ phản hồi hình ảnh dưới 0,1 ms cùng các công nghệ gaming như G-Sync, FreeSync, HGIG Mode, ALLM và Dolby Vision Gaming/HDR10+ Gaming mang lại trải nghiệm chơi game cực kỳ mượt mà và chân thực. Chế độ FilmMaker Mode giúp tái hiện đúng ý đồ nghệ thuật của đạo diễn, phù hợp với người yêu phim.\n\nHệ điều hành Web OS 26 cung cấp giao diện thông minh, dễ sử dụng với AI Magic Remote MR26 và điều khiển bằng giọng nói tiếng Việt thông qua Google Assistant. Tivi hỗ trợ AirPlay 2, Google Cast, ứng dụng LG ThinQ và tích hợp MS Copilot, AI Agent, AI Concierge cùng các tính năng AI như AI Search, AI Picture Wizard và AI Sound Wizard. Tính năng Multiview cho phép xem nhiều nguồn nội dung cùng lúc.\n\nVề âm thanh, α8 AI Sound Pro mô phỏng hệ thống âm thanh ảo 9.1.2, kết hợp Clear Voice Pro và AI Acoustic Tuning để tối ưu âm thanh theo nội dung và môi trường. Tivi hỗ trợ kết nối âm thanh qua eARC (HDMI 2), SPDIF, WISA và chia sẻ chế độ âm thanh với soundbar tương thích. Kết nối đa dạng với Wi-Fi 6, Bluetooth 5.3 và cổng LAN, giúp truy cập nội dung nhanh chóng và ổn định.",
      "label": "Bài viết sản phẩm",
      "propertyType": "text area",
      "isPim": true,
      "cmsCode": null
    },
